{
  "name": "remind-memory-cli",
  "version": "0.1.0",
  "description": "External long-term memory local CLI foundation (T1). Planning: plan.md section 14.",
  "type": "commonjs",
  "main": "dist/src/cli.js",
  "bin": {
    "memory-cli": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "acceptance": "npm run build && node --test dist/tests/acceptance.test.js",
    "cli": "node dist/src/cli.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
