{
  "name": "remind-memory-cli",
  "version": "0.1.0",
  "description": "Autonomous associative memory local CLI (M1 store).",
  "type": "commonjs",
  "main": "dist/src/cli.js",
  "bin": {
    "memory-cli": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/src/cli.js', 0o755)\"",
    "test": "npm run clean && npm run build && node --test dist/tests/*.test.js",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "acceptance": "npm run clean && npm run build && node --test dist/tests/acceptance.test.js",
    "cli": "node dist/src/cli.js",
    "evaluate:baseline": "npm run build && node dist/scripts/evaluate-baseline.js",
    "eval:operations": "npm run build && node dist/scripts/evaluate-operations.js",
    "clean": "node -e \"require('fs').rm('dist',{recursive:true,force:true},()=>{})\"",
    "provision:model": "npm run build && node dist/scripts/provision-model.js",
    "provision:llm": "npm run build && node dist/scripts/provision-llm.js",
    "ingest": "npm run build && node dist/scripts/ingest.js",
    "rebuild:vectors": "npm run build && node dist/scripts/rebuild-vectors.js",
    "rebuild:graph": "npm run build && node dist/scripts/rebuild-graph.js",
    "smoke:m3": "npm run build && node dist/scripts/smoke-m3.js",
    "smoke:episodes": "npm run build && node dist/scripts/smoke-episodes.js",
    "eval:m2": "npm run build && node dist/scripts/eval-m2.js",
    "smoke:semantic": "npm run build && node dist/scripts/smoke-semantic.js"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
