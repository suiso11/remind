{
  "dbPath": "./memory.db",
  "vaultPath": "./vault",
  "allowedScopes": [
    "personal/default"
  ],
  "limits": {
    "bodyMaxCp": 2000,
    "queryMaxCp": 500,
    "tagsMax": 5,
    "linksMax": 8,
    "sourceRefsMax": 8,
    "limitDefault": 10,
    "limitMax": 25,
    "snippetMaxCp": 200,
    "responseMaxBytes": 8192,
    "rawBodyMaxCp": 8000,
    "rawPageMaxCp": 2000,
    "rangeLimitMax": 50,
    "graphResponseMaxBytes": 65536,
    "graphLimitMax": 50
  },
  "timeouts": {
    "cliMs": 5000,
    "busyMs": 2000
  },
  "dbMaxBytes": 104857600,
  "vectors": {
    "modelDir": "./models/paraphrase-multilingual-MiniLM-L12-v2",
    "topK": 20,
    "timeoutMs": 15000,
    "enabled": true
  },
  "cultivation": {
    "queueMax": 500,
    "batchMax": 20,
    "leaseTtlMs": 120000,
    "reviewMaxAttempts": 5,
    "retireMinAgeMs": 86400000
  },
  "llm": {
    "backend": "onnx",
    "modelDir": "./models/qwen25-15b-instruct",
    "timeoutMs": 60000,
    "enabled": false,
    "maxNewTokens": 48,
    "maxPromptChars": 2000
  },
  "maintenance": {
    "timeoutMs": 120000
  },
  "episodes": {
    "utcOffsetMinutes": 540,
    "windowMaxCp": 1200,
    "maxNewTokens": 128,
    "batchMax": 5
  },
  "associate": {
    "batchMax": 50,
    "topK": 5,
    "minScore": 0.45,
    "topicMergeMin": 0.8,
    "topicBonus": 0.3,
    "llmTopics": false
  },
  "consolidate": {
    "minMembers": 3,
    "batchMax": 5
  },
  "activation": {
    "decay": 0.5,
    "tauRetire": -1.5,
    "tauReactivate": -0.5,
    "minAgeHours": 72,
    "wImportance": 2.0,
    "wKind": {
      "user_fact": 1.0,
      "model_inference": 0.0,
      "summary": 0.3,
      "correction": 1.0
    },
    "reconsiderLegacy": true,
    "batchMax": 20,
    "apply": false,
    "protectImportance": 0.66
  },
  "requirePrivacy": false
}
