{
  "dbPath": "./memory.db",
  "vaultPath": "./vault",
  "allowedScopes": ["personal/default"],
  "limits": {
    "bodyMaxCp": 2000,
    "queryMaxCp": 500,
    "tagsMax": 5,
    "linksMax": 8,
    "sourceRefsMax": 8,
    "limitDefault": 10,
    "limitMax": 25,
    "snippetMaxCp": 200,
    "responseMaxBytes": 8192
  },
  "timeouts": {
    "cliMs": 5000,
    "busyMs": 2000
  },
  "dbMaxBytes": 104857600,
  "vectors": {
    "modelDir": "./models/paraphrase-multilingual-MiniLM-L12-v2",
    "topK": 20,
    "timeoutMs": 15000,
    "enabled": true
  },
  "cultivation": {
    "queueMax": 500,
    "batchMax": 20,
    "leaseTtlMs": 120000,
    "reviewMaxAttempts": 5
  },
  "llm": {
    "modelDir": "./models/qwen25-15b-instruct",
    "timeoutMs": 60000,
    "enabled": false,
    "maxNewTokens": 48,
    "maxPromptChars": 2000
  },
  "maintenance": {
    "timeoutMs": 120000
  },
  "requirePrivacy": false
}
